{
  "name": "rsvpswebsite",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/server.js",
    "test": "jest ./*test.js --coverage",
    "lint": "eslint . --ext .js",
    "lint-fix": "npm run lint -- --fix",
    "prettier": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "pre-commit": "npm run lint",
    "pre-push": "npm-check && npm test",
    "prepare": "husky install"
  },
  "nodemonConfig": {
    "ignore": [
      "tests/*",
      "docs/*",
      "*.log",
      ".github/*"
    ],
    "delay": 2500
  },
  "jest": {
    "testEnvironment": "node"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run pre-commit",
      "pre-push": "npm run pre-push"
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "debug": "^4.3.4",
    "dotenv": "^16.0.1",
    "express": "^4.18.1",
    "express-rate-limit": "^6.4.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.3.4",
    "morgan": "~1.10.0",
    "pug": "^3.0.2",
    "winston": "^3.7.2"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.25.4",
    "husky": "^8.0.1",
    "jest": "^28.1.0",
    "supertest": "^6.2.3"
  }
}
